# GenomeAI Platform — Global Environment Example Reference
# ==============================================================================
# See frontend/.env.example and backend/.env.example for component-specific files.
# ==============================================================================

# FRONTEND (Vite / Vercel):
# Set this in frontend/.env or Vercel Environment Variables:
VITE_API_BASE_URL=http://localhost:8000

# BACKEND (FastAPI / Render / Railway / Docker):
# Set these in backend/.env or your production container environment:
APP_NAME=GenomeAI Backend
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite+aiosqlite:///./genomeai.db
SECRET_KEY=change-me-to-a-real-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REPORTS_DIR=./generated_reports
GENOMEAI_DATA_SOURCE=live
HTTP_TIMEOUT_SECONDS=8.0
GEMINI_API_KEY=
NCBI_API_KEY=
