# GenomeAI Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as needed.
# ==============================================================================

APP_NAME=GenomeAI Backend
ENVIRONMENT=development
DEBUG=true

# --- Allowed CORS Origins ---
# Comma-separated list of origins allowed to access the backend.
# In production, set to your Vercel frontend URL, e.g.:
# CORS_ORIGINS=https://genomeai.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Database Connection ---
# Local development default (SQLite file — zero external setup required):
DATABASE_URL=sqlite+aiosqlite:///./genomeai.db

# Production requirement (PostgreSQL on Supabase, Neon, AWS RDS, Render, etc.):
# DATABASE_URL=postgresql+asyncpg://genomeai_user:your_password@your_pg_host:5432/genomeai_db

DATABASE_ECHO=false

# --- Authentication & JWT Security ---
# Generate a cryptographically secure random string in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-to-a-real-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Orchestrator & Report Generation ---
MOCK_AGENT_DELAY_SECONDS=0.6
REPORTS_DIR=./generated_reports

# --- Gemini (AI Planner / Multi-Agent Reasoning Engine) ---
# Intentionally Under Development — Core Gene Analysis does NOT require this.
# Optional key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOOL_ROUNDS=6

# --- Live Biomedical Data Sources ---
# live = query public APIs (MyGene.info, HGNC, ClinVar, Europe PMC) with mock fallback
# mock = pure local curated records (ideal for offline development / demos)
GENOMEAI_DATA_SOURCE=live
HTTP_TIMEOUT_SECONDS=8.0

# Optional: raises NCBI rate limits from 3/s to 10/s (free from NCBI)
NCBI_API_KEY=
